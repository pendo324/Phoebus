<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A self-hosted notification backend (apollo-backend) and bark-server
	     are usually reached over plain http on the LAN; ATS would block them. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Arbitrary loads only: alongside NSAllowsLocalNetworking, iOS
		     ignores NSAllowsArbitraryLoads. Arbitrary loads already cover
		     the local network. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCrossWebsiteTrackingUsageDescription</key>
	<string>Lets the YouTube player use the YouTube account you sign in to, for Premium, watch history and age-restricted videos.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to reach a notification backend or Bark server you host on your own network.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your approximate location is checked once to calculate sunset and sunrise for automatic theme switching. It is not shared or sent.</string>
	<!-- Declared here because xtool otherwise defaults the version to 1.0.0. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- CFBundleIcons and CFBundleIcons~ipad come from the compiled app icons,
	     merged in after the build (scripts/add-app-icons.py). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.pendo324.Phoebus.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>phoebus</string>
				<!-- The self-hosted apollo-backend builds its Bark tap URLs
				     as apollo://reddit.com/r/... and apollo://reborn/inbox.
				     Claiming `apollo` makes those taps open this app. -->
				<string>apollo</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>googlechrome</string>
		<string>googlechromes</string>
		<string>microsoft-edge-http</string>
		<string>microsoft-edge-https</string>
		<string>firefox</string>
		<string>firefox-focus</string>
		<string>brave</string>
		<string>x-icabmobile</string>
		<string>dolphin</string>
		<string>ddgQuickLink</string>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Used to save images, GIFs, and videos you choose to your Photos library.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<!-- The background inbox refresh that keeps the app icon's badge current
	     (PushNotificationCoordinator). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.pendo324.Phoebus.inbox-badge-refresh</string>
	</array>
	<!-- UIDesignRequiresCompatibility is deliberately absent. It is Apple's
	     global opt-out of the iOS 26 design system and would also force
	     every UIMenu into the legacy look (trailing icons, inline
	     submenus). List cards are suppressed per list with
	     `.scrollContentBackground(.hidden)` and per-row backgrounds/insets. -->
	<!-- Apollo Reborn writes backups as Apollo_Backup_*.apollobackup, a ZIP
	     declared as its own type. Imported (not exported): Reborn owns the
	     type; this lets the restore picker recognise the file. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.apolloreborn.backup</string>
			<key>UTTypeDescription</key>
			<string>Apollo Reborn Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>apollobackup</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- ProMotion: iPhone apps run custom animations at 60 Hz or less
	     unless this is set; the system then picks the adaptive rate (up
	     to 120 Hz). Reborn patches the same key into its IPAs. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
